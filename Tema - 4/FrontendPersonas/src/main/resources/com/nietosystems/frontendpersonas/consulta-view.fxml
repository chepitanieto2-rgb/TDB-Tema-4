
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nietosystems.frontendpersonas.controller.ConsultaController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-background-color: #F3F6FA;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Título principal -->
    <Label text="CONSULTAR PERSONAS"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #17365D;"/>

    <Label text="Visualización y administración de personas registradas"
           style="-fx-font-size: 14px;
                  -fx-text-fill: #555555;"/>

    <!-- Barra de búsqueda -->
    <HBox spacing="12" alignment="CENTER_LEFT">

        <TextField fx:id="txtBuscar"
                   promptText="Buscar por ID, nombre o apellidos"
                   HBox.hgrow="ALWAYS"/>

        <Button text="Buscar"
                onAction="#buscarPersona"
                prefWidth="100"/>

        <Button text="Actualizar"
                onAction="#actualizarTabla"
                prefWidth="100"/>

    </HBox>

    <!-- Tabla de personas -->
    <TableView fx:id="tablaPersonas"
               prefHeight="380"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="55"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="120"/>

            <TableColumn fx:id="colApellidos"
                         text="Apellidos"
                         prefWidth="140"/>

            <TableColumn fx:id="colDireccion"
                         text="Dirección"
                         prefWidth="150"/>

            <TableColumn fx:id="colTelefono"
                         text="Teléfono"
                         prefWidth="110"/>

            <TableColumn fx:id="colAcciones"
                         text="Acciones"
                         prefWidth="155"/>

        </columns>

    </TableView>

    <!-- Información inferior -->
    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Label text="Total de registros:"/>

        <Label fx:id="lblTotal"
               text="0"
               style="-fx-font-weight: bold;
                      -fx-text-fill: #17365D;"/>

    </HBox>

</VBox>
