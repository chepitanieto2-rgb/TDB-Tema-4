
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nietosystems.frontendpersonas.controller.MainController"
            prefWidth="950"
            prefHeight="600"
            style="-fx-background-color: #F3F6FA;">

    <!-- ENCABEZADO -->
    <top>
        <VBox spacing="5"
              style="-fx-background-color: #17365D;">

            <padding>
                <Insets top="25" right="30"
                        bottom="25" left="30"/>
            </padding>

            <Label text="NIETO SYSTEMS"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Sistema de Gestión de Personas"
                   style="-fx-font-size: 15px;
                          -fx-text-fill: #DCE6F1;"/>
        </VBox>
    </top>

    <!-- MENÚ LATERAL -->
    <left>
        <VBox spacing="15"
              prefWidth="240"
              style="-fx-background-color: #24476B;">

            <padding>
                <Insets top="30" right="15"
                        bottom="20" left="15"/>
            </padding>

            <Label text="MENÚ PRINCIPAL"
                   style="-fx-text-fill: white;
                          -fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <Button text="Inicio"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#mostrarInicio"/>

            <Button text="Registrar persona"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#registrarPersona"/>

            <Button text="Consultar personas"
                    prefWidth="210"
                    prefHeight="42"
                    onAction="#consultarPersonas"/>
        </VBox>
    </left>

    <!-- CONTENEDOR DE VISTAS -->
    <center>
        <StackPane fx:id="contenedorPrincipal"
                   style="-fx-background-color: #F3F6FA;"/>
    </center>

    <!-- PIE DE PÁGINA -->
    <bottom>
        <HBox alignment="CENTER"
              prefHeight="45"
              style="-fx-background-color: #E1E8F0;">

            <Label text="Frontend JavaFX | API Spring Boot | PostgreSQL"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #34495E;"/>
        </HBox>
    </bottom>

</BorderPane>
