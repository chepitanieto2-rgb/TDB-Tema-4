
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nietosystems.frontendpersonas.controller.RegistroController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-background-color: #F3F6FA;">

    <padding>
        <Insets top="35" right="40"
                bottom="30" left="40"/>
    </padding>

    <Label text="REGISTRAR PERSONA"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #17365D;"/>

    <Label text="Complete los siguientes campos para registrar una persona."
           wrapText="true"/>

    <GridPane hgap="15" vgap="15"
              maxWidth="500">

        <Label text="Nombre:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Ingrese el nombre"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Apellidos:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtApellidos"
                   promptText="Ingrese los apellidos"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Dirección:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtDireccion"
                   promptText="Ingrese la dirección"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label text="Teléfono:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtTelefono"
                   promptText="Ingrese el teléfono"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

    </GridPane>

    <HBox alignment="CENTER" spacing="20">

        <Button text="Guardar"
                prefWidth="130"
                onAction="#guardarPersona"/>

        <Button text="Limpiar"
                prefWidth="130"
                onAction="#limpiarCampos"/>

    </HBox>

</VBox>
